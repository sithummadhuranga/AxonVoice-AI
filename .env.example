# This file is consumed by Docker Compose.
# Use it with: docker compose --env-file .env -f infra/docker-compose.yml up -d
# dotnet run and Visual Studio do not read .env files automatically.
# For direct host debugging, use .NET User Secrets instead of committing secrets.

# ─── Security ─────────────────────────────────────────────────────────────────
# Public base URL used as the JWT issuer and widget origin.
# For local Docker runs keep this at http://localhost.
PLATFORM_BASE_URL=http://localhost

# AES-256-GCM master key for encrypting tenant Gemini API keys.
# Must be a 32-byte value encoded as base64.
# Generate: openssl rand -base64 32
PLATFORM_MASTER_KEY=

# HMAC-SHA256 key for signing and verifying session JWTs.
# Generate: openssl rand -base64 64
JWT_SIGNING_KEY=

# Password-protected PFX used to encrypt ASP.NET Core DataProtection keys at rest.
# Generate or export a PFX, then base64-encode the file contents into this value.
DATA_PROTECTION_CERTIFICATE_BASE64=
DATA_PROTECTION_CERTIFICATE_PASSWORD=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=voiceagent

# Docker Compose derives the internal PostgreSQL, Redis, Qdrant, and Ollama
# addresses from the service graph. Keep only the database credentials here.

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_SUMMARY_MODEL=llama3.2

# Legacy aliases accepted by the backend services for backward compatibility.
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_COMPLETION_MODEL=llama3.2

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Public URL of the platform when the base compose file is used directly.
# The recommended development override publishes the gateway at http://localhost:8080.
NEXT_PUBLIC_API_URL=http://localhost

# ─── Rate Limiting Defaults ───────────────────────────────────────────────────
# These are platform-wide defaults; per-tenant overrides are stored in PostgreSQL.
DEFAULT_RATE_LIMIT_DAILY=1000
DEFAULT_RATE_LIMIT_CONCURRENT=20
DEFAULT_SESSION_TIMEOUT_SEC=600
DEFAULT_SILENCE_TIMEOUT_SEC=90
DEFAULT_BOOKING_HOLD_MINUTES=30

# ─── TLS (production only) ────────────────────────────────────────────────────
# Path to TLS certificate and key, mounted into the gateway container.
# Leave blank for local HTTP development.
TLS_CERT_PATH=
TLS_KEY_PATH=
