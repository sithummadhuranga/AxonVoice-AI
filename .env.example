# ─── Security ─────────────────────────────────────────────────────────────────
# AES-256-GCM master key for encrypting tenant Gemini API keys.
# Must be a 32-byte value encoded as base64.
# Generate: openssl rand -base64 32
PLATFORM_MASTER_KEY=

# HMAC-SHA256 key for signing and verifying session JWTs.
# Generate: openssl rand -base64 64
JWT_SIGNING_KEY=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=voiceagent
POSTGRES_URL=postgresql://voiceagent:change_me_in_production@postgres:5432/voiceagent

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_COMPLETION_MODEL=llama3.2

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Public URL of the platform — used by the dashboard and embedded widget.
# For local development use http://localhost (gateway on port 80).
NEXT_PUBLIC_API_URL=https://your-domain.com

# ─── Rate Limiting Defaults ───────────────────────────────────────────────────
# These are platform-wide defaults; per-tenant overrides are stored in PostgreSQL.
DEFAULT_RATE_LIMIT_DAILY=1000
DEFAULT_RATE_LIMIT_CONCURRENT=20
DEFAULT_SESSION_TIMEOUT_SEC=600
DEFAULT_SILENCE_TIMEOUT_SEC=90
DEFAULT_BOOKING_HOLD_MINUTES=30

# ─── TLS (production only) ────────────────────────────────────────────────────
# Path to TLS certificate and key, mounted into the gateway container.
# Leave blank for local HTTP development.
TLS_CERT_PATH=
TLS_KEY_PATH=
