{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "${POSTGRES_CONNECTION_STRING}"
  },
  "Redis": {
    "ConnectionString": "${REDIS_URL}"
  },
  "Security": {
    "PlatformMasterKey": "${PLATFORM_MASTER_KEY}",
    "JwtSigningKey": "${JWT_SIGNING_KEY}",
    "SessionTokenAudience": "relay",
    "SessionTokenExpiryMinutes": 15
  }
}

