{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "${POSTGRES_CONNECTION_STRING}"
  },
  "Ollama": {
    "BaseUrl": "${OLLAMA_URL}",
    "EmbeddingModel": "${OLLAMA_EMBED_MODEL}"
  },
  "Qdrant": {
    "Host": "${QDRANT_HOST}",
    "Port": 6334
  }
}

