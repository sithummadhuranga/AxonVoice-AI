{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "${REDIS_URL}"
  },
  "Security": {
    "JwtSigningKey": "${JWT_SIGNING_KEY}",
    "SessionTokenAudience": "relay"
  },
  "Services": {
    "AgentConfigUrl": "${AGENT_CONFIG_URL}",
    "KnowledgeBaseUrl": "${KNOWLEDGE_BASE_URL}",
    "ConversationStoreUrl": "${CONVERSATION_STORE_URL}"
  }
}

